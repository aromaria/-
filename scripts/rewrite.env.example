# このファイルを rewrite.env にコピーしてAPIキーを記入してください
# cp scripts/rewrite.env.example scripts/rewrite.env
#
# ⚠️ rewrite.env はGitにアップロードされません（.gitignoreで除外済み）
#
# OpenAI か Gemini のどちらかのキーを設定してください（両方あればOpenAI優先）

RESERVESTOCK_API_KEY=rs_live_ここにリザストのAPIキー

# OpenAI（おすすめ: 安定・高品質・100記事で200〜400円程度）
OPENAI_API_KEY=sk-ここにOpenAIのAPIキー

# Gemini（無料だがレート制限あり）
# GEMINI_API_KEY=ここにGeminiのAPIキー
