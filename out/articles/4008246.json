  "context": "<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background: #f6f5f3; width: 100%\">\r\n<tbody>\r\n<tr>\r\n<td background=\"https://www.reservestock.jp/images/mail_patterns/paper-fibers.png\" style=\"background-color: #f6f5f3\">\r\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n<tbody>\r\n<tr>\r\n<td align=\"center\">\r\n<table role=\"presentation\" class=\"main_contents\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin: 0 auto; width: 100%; max-width: 640px\">\r\n<tbody>\r\n<tr>\r\n<td style=\"color: #222222; background: #ffffff; font-size: 19px; line-height: 1.9; letter-spacing: 0.02em; padding: 5px 5px; border-radius: 2px\">\r\n<div style=\"border-radius: 2px\">\r\n<section id=\"main_text\"><!-- パーソナライズ・挨拶（信頼づくり） -->\n<div style=\"padding: 16px 0px 0\">\n<p style=\"font-size: 19px; margin: 0 0 10px 0\"><!-- x-tinymce/html --></p>\n<p style=\"font-size: 19px\">&nbsp;&nbsp;</p>\n<p style=\"font-size: 19px\">((customer_name)) さん、こんばんは✨</p>\n<p style=\"font-size: 19px\">アロマリア自然療法の学校 校長 岩本 純子です。</p>\n<p style=\"font-size: 19px\"><br /></p>\n<p style=\"font-size: 19px\">唯一無二の大切なあなたに寄り添い、美と健康、心身魂のトータルケアをサポートいたします。</p>\n<img alt=\"岩本 純子\" src=\"https://www.reservestock.jp/pictures/9582_NzMyZDZmNjU1ZDNmNzIxNGVjMjMzMGVjN2Q5ODI1NzY.jpeg\" style=\"display: block; margin: 12px 0; border-radius: 60px; width: 120px; height: 120px\"></div>\n<p style=\"font-size: 19px\"><br /></p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p>\n<p style=\"font-size: 19px\">&nbsp;</p></section>\r\n<!-- ===================== 1st CTA（最重要） ===================== --><!-- ===================== 記事誘導（オプション） ===================== --><!-- ===================== 社会的証明（他者紹介/登録導線） ===================== -->\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">((mail_phrases_1))</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<!-- === マイページ導線（購入済みコンテンツ／イベントアーカイブ） ================== -->\r\n<section id=\"announcement\"><!-- ========== 共同プロジェクト（社会的証明＋一次CTA） ========== --><!-- ========== 単発イベント一覧（“日付”で即断→CTA） ========== --><!-- ========== 結論（商品/講座 等）を強CTAで並べる ========== --><!-- ========== ショップ ========== --><!-- ========== 代理店 ========== --><!-- ========== 予約 ========== --><!-- ========== 利用者の声（社会的証明） ========== -->\r\n<p>&nbsp;</p>\r\n<div style=\"color: #222222; background: #f4dddb; margin: 10px 10px; padding: 14px 4px; border: 1px solid #efe7df; border-radius: 16px\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"border: 2px solid #8fbf9f; border-radius: 40px; width: 80px; height: 80px\"></div>\r\n<div style=\"color: #222222; font-size: 13px; text-align: center; margin: 10px 0\">とみた 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"padding: 6px 0 6px 6px\">\r\n<div style=\"color: #222222; font-size: 16px; font-weight: bold; padding: 8px 0 4px\">AEAJアロマテラピーアドバイザー認定講習会・アロマリア自然療法の学校</div>\r\n<div style=\"color: #222222; font-size: 21px; font-weight: bold; line-height: 1.5; padding: 2px 0 8px\">出会いに感謝！！</div>\r\n<div style=\"background: #e7a8a1; line-height: 0; display: block; margin: -8px 0 10px 0; border-radius: 6px; height: 4px\"></div>\r\n<div style=\"color: #222222; font-size: 12pt; line-height: 1.6\">とても丁寧にご講義いただき、あっという間に時間が過ぎま...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px\">\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; line-height: 1.9; margin: 6px 0; padding: 21px 18px; border: 1px solid #efe7df; border-radius: 10px\">とても丁寧にご講義いただき、あっという間に時間が過ぎました。先生のお人柄が素晴らしく、もっと学びたいと感じました。ありがとうございました。</div>\r\n</div>\r\n<!-- 事業者からの返信 -->\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; display: flex; margin: 12px 4px 4px; padding: 12px 14px; border: 1px solid #efe7df; border-radius: 12px\">\r\n<div><img alt=\"岩本 純子\" src=\"https://www.reservestock.jp/pictures/9582_NzMyZDZmNjU1ZDNmNzIxNGVjMjMzMGVjN2Q5ODI1NzY.jpeg\" style=\"border: 2px solid #8fbf9f; border-radius: 60px; width: 46px\"></div>\r\n<div style=\"font-size: 0.95em; line-height: 1.8; margin-left: 10pt\"><strong>岩本 純子 からの返信</strong><br>とっても嬉しいご感想を頂きありがとうございました チュラルな精油の叡智とハーブからのパワーを活かす知識をこれからも一緒に学んでゆきましょうね</div>\r\n</div>\r\n<!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"color: #222222; background: #f4dddb; margin: 10px 10px; padding: 14px 4px; border: 1px solid #efe7df; border-radius: 16px\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"border: 2px solid #8fbf9f; border-radius: 40px; width: 80px; height: 80px\"></div>\r\n<div style=\"color: #222222; font-size: 13px; text-align: center; margin: 10px 0\">とくこ 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"padding: 6px 0 6px 6px\">\r\n<div style=\"color: #222222; font-size: 16px; font-weight: bold; padding: 8px 0 4px\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"color: #222222; font-size: 21px; font-weight: bold; line-height: 1.5; padding: 2px 0 8px\">めっちゃ感動しました</div>\r\n<div style=\"background: #e7a8a1; line-height: 0; display: block; margin: -8px 0 10px 0; border-radius: 6px; height: 4px\"></div>\r\n<div style=\"color: #222222; font-size: 12pt; line-height: 1.6\">ふだん薬も飲まず、病院とはご縁がない方でしたが、年齢の...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px\">\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; line-height: 1.9; margin: 6px 0; padding: 21px 18px; border: 1px solid #efe7df; border-radius: 10px\">ふだん薬も飲まず、病院とはご縁がない方でしたが、年齢の筋目に健診のつもりでメタトロンを受けてみたいと思い立ち、メタトロンなら岩本さん☆だと是非受けたいと会いに行きました。 <br>数年ぶりにお会いできて感動～☆ <br>相変わらず美しかったし、益々光り輝いてどんどん新たな学びを拡げられ、何よりお一人お一人をたいせつにし真摯な姿勢で丁寧にご対応されて癒し改善に導いていらっしゃる、本当に素晴らしい☆と改めて尊敬の氣もちが溢れました。 <br>予定時間を大幅オーバーする位（居心地が最高過ぎて）、丁寧に分かりやすく説明して頂きました。身体に負担のないやさしい機器を駆使されて、至れり尽くせり心底深くケアして頂いて感謝しています。　周波数調整までして頂いて、ゆっくり落ち着いて話もできて有り難く佳き時間を過ごすことができました。 <br>帰る頃にはすっかり元氣度がアップし穏やかな氣もちになりました。 <br>お会いできて、セッションを受けることができて本当に本当によかった☆ <br>有り難うございました。 </div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"color: #222222; background: #f4dddb; margin: 10px 10px; padding: 14px 4px; border: 1px solid #efe7df; border-radius: 16px\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"border: 2px solid #8fbf9f; border-radius: 40px; width: 80px; height: 80px\"></div>\r\n<div style=\"color: #222222; font-size: 13px; text-align: center; margin: 10px 0\">新坂 真由美 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"padding: 6px 0 6px 6px\">\r\n<div style=\"color: #222222; font-size: 16px; font-weight: bold; padding: 8px 0 4px\">無料相談（オンライン通話/Zoom）</div>\r\n<div style=\"color: #222222; font-size: 21px; font-weight: bold; line-height: 1.5; padding: 2px 0 8px\">とても勉強になりました</div>\r\n<div style=\"background: #e7a8a1; line-height: 0; display: block; margin: -8px 0 10px 0; border-radius: 6px; height: 4px\"></div>\r\n<div style=\"color: #222222; font-size: 12pt; line-height: 1.6\">今日はお時間とって下さってありがとうございました。 ...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px\">\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; line-height: 1.9; margin: 6px 0; padding: 21px 18px; border: 1px solid #efe7df; border-radius: 10px\">今日はお時間とって下さってありがとうございました。 <br>エネルギッシュな先生のお話を聞けてとても元気になりました。 <br>もっと近ければよかったのになと思いながらお話を聞いていました。 <br><br>セルフケア、恋をして自分を大切にしたいです。 <br><br>先生ありがとうございました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"color: #222222; background: #f4dddb; margin: 10px 10px; padding: 14px 4px; border: 1px solid #efe7df; border-radius: 16px\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"border: 2px solid #8fbf9f; border-radius: 40px; width: 80px; height: 80px\"></div>\r\n<div style=\"color: #222222; font-size: 13px; text-align: center; margin: 10px 0\">K.I 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"padding: 6px 0 6px 6px\">\r\n<div style=\"color: #222222; font-size: 16px; font-weight: bold; padding: 8px 0 4px\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"color: #222222; font-size: 21px; font-weight: bold; line-height: 1.5; padding: 2px 0 8px\">本当いつもお世話になってます</div>\r\n<div style=\"background: #e7a8a1; line-height: 0; display: block; margin: -8px 0 10px 0; border-radius: 6px; height: 4px\"></div>\r\n<div style=\"color: #222222; font-size: 12pt; line-height: 1.6\">気分の浮き沈みの激しい私ですが、パワフルで楽しい岩本先...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px\">\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; line-height: 1.9; margin: 6px 0; padding: 21px 18px; border: 1px solid #efe7df; border-radius: 10px\">気分の浮き沈みの激しい私ですが、パワフルで楽しい岩本先生にお会いするだけでも元気がでます。 <br>今回はメタトロンとAlpeonの体験ができました。視覚的にも楽しめるAlpeonとメタトロンで体が調えられたかんじがしました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"color: #222222; background: #f4dddb; margin: 10px 10px; padding: 14px 4px; border: 1px solid #efe7df; border-radius: 16px\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"border: 2px solid #8fbf9f; border-radius: 40px; width: 80px; height: 80px\"></div>\r\n<div style=\"color: #222222; font-size: 13px; text-align: center; margin: 10px 0\">まな 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"padding: 6px 0 6px 6px\">\r\n<div style=\"color: #222222; font-size: 16px; font-weight: bold; padding: 8px 0 4px\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"color: #222222; font-size: 21px; font-weight: bold; line-height: 1.5; padding: 2px 0 8px\">本当いつもお世話になってます</div>\r\n<div style=\"background: #e7a8a1; line-height: 0; display: block; margin: -8px 0 10px 0; border-radius: 6px; height: 4px\"></div>\r\n<div style=\"color: #222222; font-size: 12pt; line-height: 1.6\">先日はありがとうございました！ 2年前の体調不調から...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px\">\r\n<div style=\"color: #222222; background: #f3ebe0; font-size: 0.95em; line-height: 1.9; margin: 6px 0; padding: 21px 18px; border: 1px solid #efe7df; border-radius: 10px\">先日はありがとうございました！ <br>2年前の体調不調から純子さんに出会い、家族でお世話になっています。(娘のアトピーや娘と息子の鼻呼吸への改善など) <br>今回も食生活など色んな視点からアドバイスをもらい純子さんと話しているだけでパワーチャージ出来ます♪(サロン自体がパワースポットのような感じがします(笑)) <br>2年の間に希望だった妊娠、出産もでき、最初の頃に比べたら身体がとても良くなってきてるのが分かります！ <br><br>今回は新しく取り入れた機器も体感しましたが受けてる間、1歳になる息子をずっと抱っこしていたのにその日は疲れをあまり感じず、体調が良かったです‼︎ <br>自分が元気に健康になるには思考も大事だと言う事は分かっていたのですが、自分の過去の悲しいみや怒りなどがまだちゃんと受け入れて手放せていなかった事がよくわかりました。 <br>小さい時から、早く大人になり強くなりたい、泣かないようにしなきゃと無意識のうちに頑張っていたんだと、話していて涙が出てきました！もう手放して自分と家族の幸せを感じて生きます♪ <br>３人の子供達や夫がいる♪それだけで素敵な事なんだと忘れていた気がします&hellip; <br>いつも色々な話しを聞けてとても楽しい時間です‼︎毎回色んな気づきが得られます♪ <br>ありがとうございました。 </div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"https://www.reservestock.jp/page/user_recommend/9582\" style=\"color: #ffffff; background: #8fbf9f; font-size: 17px; font-weight: bolder; text-decoration: none; text-align: center; letter-spacing: 2px; display: block; margin: 10px auto; padding: 0.7em 1em; border-bottom: solid 4px #6b8f77; border-radius: 18px; max-width: 364px\">⭐️ 満足度の理由を口コミで確認 </a></p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>\r\n<!-- ========== お問い合わせ ========== --><!-- ========== オプチャページ ========== --><!-- ========== サポートイベント（複数時は日付リスト） ========== --></section>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<!-- === /マイページ導線 =================================================== -->\r\n<div style=\"background: #f4dddb; margin: 18px 10px; padding: 18px; border: 1px solid #efe7df; border-radius: 14px; max-width: 640px\">\r\n<h3 style=\"color: #222222; font-size: 19px; text-align: center; line-height: 1.5; margin: 0 0 10px 0\"> マイページで「購入済みコンテンツ」や「イベントのアーカイブ」をチェック</h3>\r\n<!-- 大ボタン：まずはマイページ -->\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"https://smart.reservestock.jp/my_page/top/9582/((proposal_code))\" style=\"color: #ffffff; background: #8fbf9f; font-size: 17px; font-weight: bolder; text-decoration: none; text-align: center; letter-spacing: 2px; display: block; margin: 10px auto; padding: 0.7em 1em; border-bottom: solid 4px #6b8f77; border-radius: 18px; max-width: 364px\">((customer_name)) 専用マイページを開く ▶</a></p>\r\n<!-- コピー用の生URL（到達率向上のため） -->\r\n<p style=\"font-size: 13px; text-align: center; margin-top: 12px\">URL: https://smart.reservestock.jp/my_page/top/9582/((proposal_code))</p>\r\n</div>\r\n<!-- ===================== LINE誘導（強化版） ===================== -->\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<div style=\"margin: 18px 10px; padding: 12px; border: 6px dashed #9ccc65; border-radius: 12px; max-width: 640px\">\r\n<div style=\"margin: 0 5px; max-width: 640px\">\r\n<p style=\"font-size: 19px; font-weight: bold; margin: 0 0 6px 0\">公式LINEで最新情報を最速で受け取りたい方はこちら：</p>\r\n<p style=\"font-size: 19px; margin: 0 0 6px 0\">((customer_name))専用｜公式LINE 初回登録用リンク</p>\r\n<p style=\"font-size: 19px\"><strong>((line_url))</strong></p>\r\n<div style=\"text-align: center; margin: 10px 0\"><a href=\"((line_url))\" style=\"text-decoration: none\"> <img src=\"https://www.reservestock.jp/images/line_inst.jpeg\" alt=\"公式LINE登録の手順\" style=\"border-radius: 12px; width: 360px\"> </a></div>\r\n<div style=\"margin: 8px 0 0 0\">\r\n<p style=\"font-size: 19\">感想などあれば <strong>LINEのチャット</strong>で送ってください♪</p>\r\n<p style=\"font-size: 19px; margin: 4px 0 0 0\">（このメールに返信でも大丈夫です^ ^）</p>\r\n</div>\r\n<div style=\"text-align: center; margin-top: 10px\"><!-- 初回登録ボタン -->\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"((line_url))\" style=\"color: #ffffff; background: #8fbf9f; font-size: 17px; font-weight: bolder; text-decoration: none; text-align: center; letter-spacing: 2px; display: block; margin: 10px auto; padding: 0.7em 1em; border-bottom: solid 4px #6b8f77; border-radius: 18px; max-width: 364px\">公式LINEに登録する </a></p>\r\n<!-- 連携済み向け：メッセージ送信ボタン -->\r\n<div style=\"margin: 6px 0 0 0\">連携済みの方はこちらから&darr;</div>\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"((line_url))\" style=\"color: #ffffff; background: #06C755; font-size: 17px; font-weight: bolder; text-decoration: none; text-align: center; letter-spacing: 2px; display: block; margin: 10px auto; padding: 0.7em 1em; border-bottom: solid 4px #6b8f77; border-radius: 18px; max-width: 364px\">LINEでメッセージを送る </a></p>\r\n</div>\r\n</div>\r\n</div>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<!-- =================