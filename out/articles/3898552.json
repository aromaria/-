{
  "id": 3898552,
  "subject": "((customer_name))の身体が今、本当に求めているものを知っていますか？",
  "context": "<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 100%; background: #f6f5f3\">\r\n<tbody>\r\n<tr>\r\n<td background=\"https://www.reservestock.jp/images/mail_patterns/paper-fibers.png\" style=\"background-color: #f6f5f3; background-image: url('https://www.reservestock.jp/images/mail_patterns/paper-fibers.png'); background-repeat: repeat; background-position: top center\">\r\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n<tbody>\r\n<tr>\r\n<td align=\"center\">\r\n<table role=\"presentation\" class=\"main_contents\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 100%; max-width: 640px; margin: 0 auto; table-layout: fixed; border-collapse: separate; box-shadow: 0 8px 24px rgba(30,30,30,0.13); mso-table-lspace: 0pt; mso-table-rspace: 0pt\">\r\n<tbody>\r\n<tr>\r\n<td style=\"background: #ffffff; border-radius: 2px; padding: 5px 5px; font-size: 19px; line-height: 1.9; word-break: break-word; overflow-wrap: anywhere; color: #222222; letter-spacing: 0.02em; -webkit-text-size-adjust: 100%\">\r\n<div style=\"box-shadow: 0 8px 24px rgba(30,30,30,0.13); border-radius: 2px\">\r\n<section id=\"main_text\"><div style=\"text-align: center\">&nbsp;</div>\r\n<div style=\"text-align: center\"><img src=\"https://www.reservestock.jp/upload_images/9582_3e9ace3309233a8fbc2123cb77711973.png\" alt=\"\" width=\"600\" height=\"200\"></div>\r\n<p style=\"text-align: center; font-size: 19px\"><img src=\"https://resast.jp/images/icon/appl_setumei.png\" width=\"300\"></p>\r\n<p style=\"font-size: 19px\"><a href=\"https://smart.reservestock.jp/menu/application_install_page\"><img style=\"display: block; margin-left: auto; margin-right: auto\" src=\"https://resast.jp/images/icon/install_hakochira.png\" width=\"300\"></a></p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong>♪アロマリアのメルマガを<br>アプリでお読みの方へ♪</strong></span></p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong><span style=\"color: #ff00ff\">いいね♡を最高30回まで連打<br></span>できるそうです♡</strong></span></p>\r\n<p style=\"text-align: center; font-size: 19px\">&nbsp;</p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong><span style=\"color: #ff00ff\">10回以上連打</span>した<br>((customer_name))からの</strong></span></p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong>お名前がぴょんと<br>すぐに</strong></span><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong>私に届くので♪</strong></span></p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong><span style=\"color: #ff00ff\">“幸せ招きのエネルギーを<br>お届けします♪”</span></strong></span></p>\r\n<p style=\"text-align: center; font-size: 19px\"><span style=\"font-family: 'Hachi Maru Pop', 'Hachi Maru Pop'; color: #008000\"><strong><span style=\"color: #ff00ff\">楽しみながらチャレンジ<br></span>してみてくださいね♪</strong></span></p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px; text-align: center\">&nbsp;</p>\r\n<div>&nbsp;</div>\r\n<div style=\"padding: 23px 8px; color: #222222; border: dashed 4px #eab2ab; border-radius: 8px\">\r\n<p data-start=\"430\" data-end=\"472\"><!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>こんにちは</p>\r\n<p data-start=\"430\" data-end=\"472\">地球ランドの美健康サポーター<br data-start=\"446\" data-end=\"449\">アロマリア自然療法の学校<br data-start=\"461\" data-end=\"464\">校長の岩本です✨</p>\r\n<p data-start=\"430\" data-end=\"472\"><br /></p>\r\n<p data-start=\"474\" data-end=\"573\">私は、お肉が大好きです數</p>\r\n<p data-start=\"474\" data-end=\"573\"><br data-start=\"489\" data-end=\"492\">でも、ただ「好きだから食べる」のではなく、<br data-start=\"513\" data-end=\"516\">健康を大切にしているからこそ、</p>\r\n<p data-start=\"474\" data-end=\"573\"><br data-start=\"531\" data-end=\"534\"><strong data-start=\"534\" data-end=\"563\">どんな環境で育ち、</strong></p>\r\n<p data-start=\"474\" data-end=\"573\"><strong data-start=\"534\" data-end=\"563\">どんな命の時間を過ごしてきたのか</strong></p>\r\n<p data-start=\"474\" data-end=\"573\">を大切にしています。　</p>\r\n<p data-start=\"474\" data-end=\"573\"><br /></p>\r\n<p data-start=\"575\" data-end=\"635\">そんな私が心から</p>\r\n<p data-start=\"575\" data-end=\"635\">惚れ込んでいるのが、<br data-start=\"593\" data-end=\"596\">岩手県で大切に育てられている<br data-start=\"610\" data-end=\"613\">**【グラスフェッドの短角牛】**です✨</p>\r\n<p data-start=\"575\" data-end=\"635\"><br /></p>\r\n<p data-start=\"637\" data-end=\"678\">広大な牧場で、</p>\r\n<p data-start=\"637\" data-end=\"678\">のんびり草を食みながら育つ牛たち。<br data-start=\"661\" data-end=\"664\">その自然な姿を実際に見た時</p>\r\n<p data-start=\"637\" data-end=\"678\"><br /></p>\r\n<p data-start=\"680\" data-end=\"731\">「やっぱり、いのちは<br data-start=\"690\" data-end=\"693\">無理をかけられず、</p>\r\n<p data-start=\"680\" data-end=\"731\">自然に近い形で育まれることが<br data-start=\"716\" data-end=\"719\">こんなにも大切なんだ…」</p>\r\n<p data-start=\"733\" data-end=\"743\">と、深く感じました。</p>\r\n<p data-start=\"733\" data-end=\"743\"><br /></p>\r\n<p data-start=\"745\" data-end=\"799\">そして実際にいただく</p>\r\n<p data-start=\"745\" data-end=\"799\">短角牛のお肉は、<br data-start=\"763\" data-end=\"766\">クセがなくて、やさしくて、<br data-start=\"779\" data-end=\"782\">噛むほどに旨みが広がるのです凉✨</p>\r\n<p data-start=\"745\" data-end=\"799\"><br /></p>\r\n<p data-start=\"801\" data-end=\"837\">脂の重さではなく、<br data-start=\"810\" data-end=\"813\"><strong data-start=\"813\" data-end=\"837\">“いのち本来の豊かさ”を</strong></p>\r\n<p data-start=\"801\" data-end=\"837\"><strong data-start=\"813\" data-end=\"837\">感じるおいしさ。</strong></p>\r\n<p data-start=\"801\" data-end=\"837\"><strong data-start=\"813\" data-end=\"837\"></strong></p>\r\n<p data-start=\"839\" data-end=\"878\">身体が喜ぶものって、<br data-start=\"849\" data-end=\"852\">こういうことなんだなぁ…と<br data-start=\"865\" data-end=\"868\">しみじみ思います</p>\r\n<p data-start=\"839\" data-end=\"878\"><br /></p>\r\n<p data-start=\"880\" data-end=\"893\">でも、ここで大切なのは――</p>\r\n<p data-start=\"880\" data-end=\"893\"><br /></p>\r\n<p data-start=\"895\" data-end=\"957\"><strong data-start=\"895\" data-end=\"949\">良いものを食べていても、<br data-start=\"909\" data-end=\"912\">今の自分の身体がその栄養を</strong></p>\r\n<p data-start=\"895\" data-end=\"957\"><strong data-start=\"895\" data-end=\"949\">どう受け取れているかは、<br data-start=\"937\" data-end=\"940\">人によって違う</strong>ということです。</p>\r\n<p data-start=\"895\" data-end=\"957\"><br /></p>\r\n<p data-start=\"959\" data-end=\"972\">どんなに食の質を上げても、</p>\r\n<p data-start=\"974\" data-end=\"1045\">・なんだか疲れやすい<br data-start=\"984\" data-end=\"987\">・眠ってもすっきりしない<br data-start=\"999\" data-end=\"1002\">・胃腸が重たい<br data-start=\"1009\" data-end=\"1012\">・気分の浮き沈みがある<br data-start=\"1023\" data-end=\"1026\">・頑張っているのに身体が応えてくれない</p>\r\n<p data-start=\"1047\" data-end=\"1062\">そんなこと、ありませんか？梁</p>\r\n<p data-start=\"1047\" data-end=\"1062\"><br /></p>\r\n<p data-start=\"1064\" data-end=\"1116\">実はそれは、<br data-start=\"1070\" data-end=\"1073\"><!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>の身体が<br data-start=\"1080\" data-end=\"1083\">「気づいてほしいサイン」を<br data-start=\"1096\" data-end=\"1099\">静かに出しているのかもしれません。</p>\r\n<p data-start=\"1064\" data-end=\"1116\"><br /></p>\r\n<p data-start=\"1118\" data-end=\"1157\">身体はいつも、<br data-start=\"1125\" data-end=\"1128\">言葉にならない声で<br data-start=\"1137\" data-end=\"1140\">私たちにメッセージを送っています。</p>\r\n<p data-start=\"1118\" data-end=\"1157\"><br /></p>\r\n<p data-start=\"1159\" data-end=\"1195\">でも忙しい毎日の中では、<br data-start=\"1171\" data-end=\"1174\">その小さなサインをうっかり</p>\r\n<p data-start=\"1159\" data-end=\"1195\">見逃してしまいがちです。</p>\r\n<p data-start=\"1159\" data-end=\"1195\"><br /></p>\r\n<p data-start=\"1197\" data-end=\"1256\">だからこそ私は、<br data-start=\"1205\" data-end=\"1208\">食を整えることと同じくらい、</p>\r\n<p data-start=\"1197\" data-end=\"1256\"><br data-start=\"1222\" data-end=\"1225\"><strong>“今の自分の身体の情報を知ること”</strong></p>\r\n<p data-start=\"1197\" data-end=\"1256\">を大切にしています✨</p>\r\n<p data-start=\"1197\" data-end=\"1256\"><br /></p>\r\n<p data-start=\"1258\" data-end=\"1293\">そこでおすすめしたいのが、<br data-start=\"1271\" data-end=\"1274\"><strong data-start=\"1274\" data-end=\"1289\">メタトロン ケアコース</strong>です</p>\r\n<p data-start=\"1258\" data-end=\"1293\"><br /></p>\r\n<p data-start=\"1295\" data-end=\"1378\">メタトロン ケアコースでは、<br data-start=\"1309\" data-end=\"1312\">今の身体の細胞レベルまでの</p>\r\n<p data-start=\"1295\" data-end=\"1378\">状態を見つめ、</p>\r\n<p data-start=\"1295\" data-end=\"1378\"><br data-start=\"1324\" data-end=\"1327\">自分でも気づいていなかった<br data-start=\"1340\" data-end=\"1343\">負担になっている</p>\r\n<p data-start=\"1295\" data-end=\"1378\">社会毒の傾向や、意識や、</p>\r\n<p data-start=\"1295\" data-end=\"1378\">整えていきたいポイントを<br data-start=\"1362\" data-end=\"1365\">丁寧に読み解き</p>\r\n<p data-start=\"1295\" data-end=\"1378\">オペレーターの岩本が</p>\r\n<p data-start=\"1295\" data-end=\"1378\">自然療法ケアで大切にしている</p>\r\n<p data-start=\"1295\" data-end=\"1378\">“未病からの回復に繋がる</p>\r\n<p data-start=\"1295\" data-end=\"1378\"><!-- x-tinymce/html --><span><strong>((customer_name))の体内の</strong></span></p>\r\n<p data-start=\"1295\" data-end=\"1378\">情報を解説して分かりやすく</p>\r\n<p data-start=\"1295\" data-end=\"1378\">お伝えしてゆきます。</p>\r\n<p data-start=\"1295\" data-end=\"1378\"><br /></p>\r\n<p data-start=\"1380\" data-end=\"1436\">「なぜ不調を感じやすいのか」<br data-start=\"1394\" data-end=\"1397\">「今の<!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>に必要なケアは何か」<br data-start=\"1411\" data-end=\"1414\">「どこから整えていくとラクになりやすいのか」</p>\r\n<p data-start=\"1438\" data-end=\"1488\">そんなヒントを受け取りながら、</p>\r\n<p data-start=\"1438\" data-end=\"1488\"><br data-start=\"1453\" data-end=\"1456\"><!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>だけにぴったり合う</p>\r\n<p data-start=\"1438\" data-end=\"1488\">養生とケアの方向性を<br data-start=\"1470\" data-end=\"1473\">一緒に見つけていくことに</p>\r\n<p data-start=\"1438\" data-end=\"1488\">つながる大切なあなただけの</p>\r\n<p data-start=\"1438\" data-end=\"1488\">取り扱い説明書を理解する</p>\r\n<p data-start=\"1438\" data-end=\"1488\">ことが叶います</p>\r\n<p data-start=\"1438\" data-end=\"1488\"><br /></p>\r\n<p data-start=\"1490\" data-end=\"1496\">多くの方が、</p>\r\n<p data-start=\"1498\" data-end=\"1582\">「自分の身体って、こんなに頑張ってくれていたんですね」<br data-start=\"1525\" data-end=\"1528\">「原因がひとつじゃないことが分かって安心しました」<br data-start=\"1553\" data-end=\"1556\">「今の自分に必要なことが見えて、前向きになれました」</p>\r\n<p data-start=\"1584\" data-end=\"1594\">と、おっしゃいます✨</p>\r\n<p data-start=\"1584\" data-end=\"1594\"><br /></p>\r\n<p data-start=\"1596\" data-end=\"1637\">身体は、敵ではなく<br data-start=\"1605\" data-end=\"1608\">いつもあなたを守ろうとしてくれている<br data-start=\"1626\" data-end=\"1629\">大切な存在です。</p>\r\n<p data-start=\"1596\" data-end=\"1637\"><br /></p>\r\n<p data-start=\"1639\" data-end=\"1730\">だからこそ、ただ我慢したり、</p>\r\n<p data-start=\"1639\" data-end=\"1730\">気合いで乗り切るのではなく、</p>\r\n<p data-start=\"1639\" data-end=\"1730\"><br data-start=\"1670\" data-end=\"1673\">**“自分の身体を知って、</p>\r\n<p data-start=\"1639\" data-end=\"1730\">寄り添ってあげること”**が<br data-start=\"1700\" data-end=\"1703\">本当の意味でのセルフケアの</p>\r\n<p data-start=\"1639\" data-end=\"1730\">第一歩だと私は感じています。</p>\r\n<p data-start=\"1639\" data-end=\"1730\"><br /></p>\r\n<p data-start=\"1732\" data-end=\"1796\">良い食材を選ぶことも愛。<br data-start=\"1744\" data-end=\"1747\">身体の声を知ることも愛。</p>\r\n<p data-start=\"1732\" data-end=\"1796\"><br data-start=\"1759\" data-end=\"1762\">そして、今の自分に</p>\r\n<p data-start=\"1732\" data-end=\"1796\">必要な整え方を選ぶことは<br data-start=\"1783\" data-end=\"1786\">もっと深い愛です</p>\r\n<p data-start=\"1732\" data-end=\"1796\"><br /></p>\r\n<p data-start=\"1798\" data-end=\"1806\">もし今<!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>が、</p>\r\n<p data-start=\"1808\" data-end=\"1878\">「私の身体、今どんな状態なんだろう？」<br data-start=\"1827\" data-end=\"1830\">「頑張っているのに整わない理由を知りたい」<br data-start=\"1851\" data-end=\"1854\">「自分に合う自然療法的なケアの方向性を知りたい」</p>\r\n<p data-start=\"1880\" data-end=\"1927\">そう感じているなら、<br data-start=\"1890\" data-end=\"1893\">メタトロン ケアコースは<br data-start=\"1905\" data-end=\"1908\">きっと大きな気づきの時間になります</p>\r\n<p data-start=\"1880\" data-end=\"1927\"><br /></p>\r\n<p data-start=\"1929\" data-end=\"1977\"><strong data-start=\"1929\" data-end=\"1951\">身体は、ちゃんと答えを持っています。</strong></p>\r\n<p data-start=\"1929\" data-end=\"1977\"><br data-start=\"1951\" data-end=\"1954\">不調を長年こじらせて</p>\r\n<p data-start=\"1929\" data-end=\"1977\">服薬で症状を抑えているだけで</p>\r\n<p data-start=\"1929\" data-end=\"1977\">根本的に回復できないことが</p>\r\n<p data-start=\"1929\" data-end=\"1977\">起こる前に…</p>\r\n<p data-start=\"1929\" data-end=\"1977\"><br /></p>\r\n<p data-start=\"1929\" data-end=\"1977\"><!-- x-tinymce/html --><span><strong>((customer_name))も</strong></span></p>\r\n<p data-start=\"1929\" data-end=\"1977\"><span><strong>身体が発している</strong></span>その声を、</p>\r\n<p data-start=\"1929\" data-end=\"1977\">一緒にメタトロン 解析&amp;ケア時に</p>\r\n<p data-start=\"1929\" data-end=\"1977\">やさしく聴いてみませんか？</p>\r\n<p data-start=\"1929\" data-end=\"1977\"><br /></p>\r\n<p data-start=\"1979\" data-end=\"2020\">▼メタトロン ケアコースの詳細・お申込みはこちら<br data-start=\"2003\" data-end=\"2006\">【ここにリザスト申込リンク】</p>\r\n<p data-start=\"1979\" data-end=\"2020\"><br /></p>\r\n<p data-start=\"2022\" data-end=\"2053\">大切な<!-- x-tinymce/html --><span><strong>((customer_name))</strong></span>が、<br data-start=\"2030\" data-end=\"2033\">もっと自分の身体と</p>\r\n<p data-start=\"2022\" data-end=\"2053\">仲良くなれますように✨</p>\r\n<p data-start=\"2022\" data-end=\"2053\"><br /></p>\r\n<p data-start=\"2055\" data-end=\"2083\">愛を込めて<br data-start=\"2060\" data-end=\"2063\">アロマリア自然療法の学校<br data-start=\"2075\" data-end=\"2078\">校長 岩本</p>\r\n<p data-start=\"2055\" data-end=\"2083\"><br /></p>\r\n</div>\r\n<div>&nbsp;</div></section>\r\n<!-- ===================== 1st CTA（最重要） ===================== --><!-- ===================== 記事誘導（オプション） ===================== --><!-- ===================== 社会的証明（他者紹介/登録導線） ===================== -->\r\n<p style=\"font-size: 19px\">((mail_phrases_1))</p>\r\n<!-- ===================== 非表示ユーザー ===================== --><!-- ===================== Good/シェア/感想（エンゲージメント） ===================== -->\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<div id=\"send_like\" style=\"max-width: 640px; padding: 12px; margin: 8px 10px; color: #222222; background: #f4dddb; border-radius: 18px\"><center style=\"padding: 6px 8px\"><!-- ===================== /感謝（チップ） ===================== -->\r\n<p style=\"font-size: 19px; font-weight: bolder; margin: 0 0 8px 0\">今回もお読みいただき、ありがとうございます。</p>\r\n<p style=\"font-size: 19px; margin: 8px 0 6px 0\">「役立った！」と感じたら、<strong>Good</strong>で応援お願いします。</p>\r\n<table>\r\n<tbody>\r\n<tr>\r\n<td>\r\n<p style=\"font-size: 19px; text-align: center; margin: 10px auto\"><a href=\"https://www.reservestock.jp/page2/send_like/9582/((proposal_code))#send_like\" style=\"width: 80px; display: inline-block; margin: 0px auto\"><img alt=\"Good\" src=\"https://www.reservestock.jp/images/like_good.png\"></a></p>\r\n</td>\r\n<td>\r\n<p style=\"margin: 14px 0 0\"><a href=\"https://smart.reservestock.jp/subscribe_form/mail_magazine_comments/9582/((proposal_code))\"><img alt=\"感想を送る\" src=\"https://www.reservestock.jp/images/comment_img_blue.png\" width=\"230px\"></a></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</center>\r\n<div style=\"text-align: center; margin: 24px 0\"><img src=\"https://www.reservestock.jp/images/icon/appl_setumei.png\" width=\"300\" alt=\"アプリ説明\"><br><a href=\"https://smart.reservestock.jp/menu/application_install_page\"> <img src=\"https://www.reservestock.jp/images/icon/install_hakochira.png\" width=\"300\" alt=\"アプリはこちら\"> </a></div>\r\n</div>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<!-- === マイページ導線（購入済みコンテンツ／イベントアーカイブ） ================== -->\r\n<section id=\"announcement\"><!-- ========== 共同プロジェクト（社会的証明＋一次CTA） ========== --><!-- ========== 単発イベント一覧（“日付”で即断→CTA） ========== --><!-- ========== 結論（商品/講座 等）を強CTAで並べる ========== --><!-- ========== ショップ ========== --><!-- ========== 代理店 ========== --><!-- ========== 予約 ========== --><!-- ========== 利用者の声（社会的証明） ========== -->\r\n<p>&nbsp;</p>\r\n<div style=\"background: #f4dddb; color: #222222; padding: 14px 4px; margin: 10px 10px; min-height: 190px; border: 1px solid #efe7df; border-radius: 16px; box-shadow: 0 6px 18px rgba(0,0,0,.06)\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"width: 80px; height: 80px; border-radius: 40px; object-fit: cover; border: 2px solid #8fbf9f\"></div>\r\n<div style=\"margin: 10px 0; text-align: center; font-size: 13px; color: #222222\">とくこ 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"flex: 1; padding: 6px 0 6px 6px\">\r\n<div style=\"padding: 8px 0 4px; font-weight: bold; font-size: 16px; color: #222222\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"padding: 2px 0 8px; font-weight: bold; font-size: 21px; line-height: 1.5; color: #222222\">めっちゃ感動しました</div>\r\n<div style=\"display: block; line-height: 0; height: 4px; background: #e7a8a1; border-radius: 6px; margin: -8px 0 10px 0\"></div>\r\n<div style=\"font-size: 12pt; line-height: 1.6; color: #222222; opacity: .95\">ふだん薬も飲まず、病院とはご縁がない方でしたが、年齢の...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px; gap: 10px\">\r\n<div style=\"font-size: 0.95em; margin: 6px 0; line-height: 1.9; background: #f3ebe0; border: 1px solid #efe7df; border-radius: 10px; padding: 21px 18px; color: #222222\">ふだん薬も飲まず、病院とはご縁がない方でしたが、年齢の筋目に健診のつもりでメタトロンを受けてみたいと思い立ち、メタトロンなら岩本さん☆だと是非受けたいと会いに行きました。 <br>数年ぶりにお会いできて感動～☆ <br>相変わらず美しかったし、益々光り輝いてどんどん新たな学びを拡げられ、何よりお一人お一人をたいせつにし真摯な姿勢で丁寧にご対応されて癒し改善に導いていらっしゃる、本当に素晴らしい☆と改めて尊敬の氣もちが溢れました。 <br>予定時間を大幅オーバーする位（居心地が最高過ぎて）、丁寧に分かりやすく説明して頂きました。身体に負担のないやさしい機器を駆使されて、至れり尽くせり心底深くケアして頂いて感謝しています。　周波数調整までして頂いて、ゆっくり落ち着いて話もできて有り難く佳き時間を過ごすことができました。 <br>帰る頃にはすっかり元氣度がアップし穏やかな氣もちになりました。 <br>お会いできて、セッションを受けることができて本当に本当によかった☆ <br>有り難うございました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"background: #f4dddb; color: #222222; padding: 14px 4px; margin: 10px 10px; min-height: 190px; border: 1px solid #efe7df; border-radius: 16px; box-shadow: 0 6px 18px rgba(0,0,0,.06)\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"width: 80px; height: 80px; border-radius: 40px; object-fit: cover; border: 2px solid #8fbf9f\"></div>\r\n<div style=\"margin: 10px 0; text-align: center; font-size: 13px; color: #222222\">新坂 真由美 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"flex: 1; padding: 6px 0 6px 6px\">\r\n<div style=\"padding: 8px 0 4px; font-weight: bold; font-size: 16px; color: #222222\">無料相談（オンライン通話/Zoom）</div>\r\n<div style=\"padding: 2px 0 8px; font-weight: bold; font-size: 21px; line-height: 1.5; color: #222222\">とても勉強になりました</div>\r\n<div style=\"display: block; line-height: 0; height: 4px; background: #e7a8a1; border-radius: 6px; margin: -8px 0 10px 0\"></div>\r\n<div style=\"font-size: 12pt; line-height: 1.6; color: #222222; opacity: .95\">今日はお時間とって下さってありがとうございました。 ...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px; gap: 10px\">\r\n<div style=\"font-size: 0.95em; margin: 6px 0; line-height: 1.9; background: #f3ebe0; border: 1px solid #efe7df; border-radius: 10px; padding: 21px 18px; color: #222222\">今日はお時間とって下さってありがとうございました。 <br>エネルギッシュな先生のお話を聞けてとても元気になりました。 <br>もっと近ければよかったのになと思いながらお話を聞いていました。 <br><br>セルフケア、恋をして自分を大切にしたいです。 <br><br>先生ありがとうございました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"background: #f4dddb; color: #222222; padding: 14px 4px; margin: 10px 10px; min-height: 190px; border: 1px solid #efe7df; border-radius: 16px; box-shadow: 0 6px 18px rgba(0,0,0,.06)\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"width: 80px; height: 80px; border-radius: 40px; object-fit: cover; border: 2px solid #8fbf9f\"></div>\r\n<div style=\"margin: 10px 0; text-align: center; font-size: 13px; color: #222222\">K.I 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"flex: 1; padding: 6px 0 6px 6px\">\r\n<div style=\"padding: 8px 0 4px; font-weight: bold; font-size: 16px; color: #222222\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"padding: 2px 0 8px; font-weight: bold; font-size: 21px; line-height: 1.5; color: #222222\">本当いつもお世話になってます</div>\r\n<div style=\"display: block; line-height: 0; height: 4px; background: #e7a8a1; border-radius: 6px; margin: -8px 0 10px 0\"></div>\r\n<div style=\"font-size: 12pt; line-height: 1.6; color: #222222; opacity: .95\">気分の浮き沈みの激しい私ですが、パワフルで楽しい岩本先...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px; gap: 10px\">\r\n<div style=\"font-size: 0.95em; margin: 6px 0; line-height: 1.9; background: #f3ebe0; border: 1px solid #efe7df; border-radius: 10px; padding: 21px 18px; color: #222222\">気分の浮き沈みの激しい私ですが、パワフルで楽しい岩本先生にお会いするだけでも元気がでます。 <br>今回はメタトロンとAlpeonの体験ができました。視覚的にも楽しめるAlpeonとメタトロンで体が調えられたかんじがしました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"background: #f4dddb; color: #222222; padding: 14px 4px; margin: 10px 10px; min-height: 190px; border: 1px solid #efe7df; border-radius: 16px; box-shadow: 0 6px 18px rgba(0,0,0,.06)\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"女性アイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"width: 80px; height: 80px; border-radius: 40px; object-fit: cover; border: 2px solid #8fbf9f\"></div>\r\n<div style=\"margin: 10px 0; text-align: center; font-size: 13px; color: #222222\">まな 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"flex: 1; padding: 6px 0 6px 6px\">\r\n<div style=\"padding: 8px 0 4px; font-weight: bold; font-size: 16px; color: #222222\">【八戸】量子力学測定器メタトロン測定＆ケア 回数券11回コース</div>\r\n<div style=\"padding: 2px 0 8px; font-weight: bold; font-size: 21px; line-height: 1.5; color: #222222\">本当いつもお世話になってます</div>\r\n<div style=\"display: block; line-height: 0; height: 4px; background: #e7a8a1; border-radius: 6px; margin: -8px 0 10px 0\"></div>\r\n<div style=\"font-size: 12pt; line-height: 1.6; color: #222222; opacity: .95\">先日はありがとうございました！ 2年前の体調不調から...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px; gap: 10px\">\r\n<div style=\"font-size: 0.95em; margin: 6px 0; line-height: 1.9; background: #f3ebe0; border: 1px solid #efe7df; border-radius: 10px; padding: 21px 18px; color: #222222\">先日はありがとうございました！ <br>2年前の体調不調から純子さんに出会い、家族でお世話になっています。(娘のアトピーや娘と息子の鼻呼吸への改善など) <br>今回も食生活など色んな視点からアドバイスをもらい純子さんと話しているだけでパワーチャージ出来ます♪(サロン自体がパワースポットのような感じがします(笑)) <br>2年の間に希望だった妊娠、出産もでき、最初の頃に比べたら身体がとても良くなってきてるのが分かります！ <br><br>今回は新しく取り入れた機器も体感しましたが受けてる間、1歳になる息子をずっと抱っこしていたのにその日は疲れをあまり感じず、体調が良かったです‼︎ <br>自分が元気に健康になるには思考も大事だと言う事は分かっていたのですが、自分の過去の悲しいみや怒りなどがまだちゃんと受け入れて手放せていなかった事がよくわかりました。 <br>小さい時から、早く大人になり強くなりたい、泣かないようにしなきゃと無意識のうちに頑張っていたんだと、話していて涙が出てきました！もう手放して自分と家族の幸せを感じて生きます♪ <br>３人の子供達や夫がいる♪それだけで素敵な事なんだと忘れていた気がします&hellip; <br>いつも色々な話しを聞けてとても楽しい時間です‼︎毎回色んな気づきが得られます♪ <br>ありがとうございました。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<div style=\"background: #f4dddb; color: #222222; padding: 14px 4px; margin: 10px 10px; min-height: 190px; border: 1px solid #efe7df; border-radius: 16px; box-shadow: 0 6px 18px rgba(0,0,0,.06)\"><!-- 上部アクセントバー（かわいく・主張しすぎない） -->\r\n<div style=\"display: flex\"><!-- 左：顔写真＋氏名 -->\r\n<div style=\"padding: 10px 12px 10px 4px; min-width: 93px\">\r\n<div style=\"text-align: center\"><img alt=\"ユーザーアイコン\" src=\"https://www.reservestock.jp/images/icon_f.png\" style=\"width: 80px; height: 80px; border-radius: 40px; object-fit: cover; border: 2px solid #8fbf9f\"></div>\r\n<div style=\"margin: 10px 0; text-align: center; font-size: 13px; color: #222222\">Aママ 様</div>\r\n</div>\r\n<!-- 右：見出し（記事名/件名）と要点 -->\r\n<div style=\"flex: 1; padding: 6px 0 6px 6px\">\r\n<div style=\"padding: 8px 0 4px; font-weight: bold; font-size: 16px; color: #222222\">身体に抗酸化力UP♪細胞レベルで元気を取り戻す☆イオン負荷ケアコース</div>\r\n<div style=\"padding: 2px 0 8px; font-weight: bold; font-size: 21px; line-height: 1.5; color: #222222\">本当いつもお世話になってます</div>\r\n<div style=\"display: block; line-height: 0; height: 4px; background: #e7a8a1; border-radius: 6px; margin: -8px 0 10px 0\"></div>\r\n<div style=\"font-size: 12pt; line-height: 1.6; color: #222222; opacity: .95\">イオンケア2回目ありがとうございました。 岩本先生の...</div>\r\n</div>\r\n</div>\r\n<!-- 本文 -->\r\n<div style=\"margin-top: 10px; gap: 10px\">\r\n<div style=\"font-size: 0.95em; margin: 6px 0; line-height: 1.9; background: #f3ebe0; border: 1px solid #efe7df; border-radius: 10px; padding: 21px 18px; color: #222222\">イオンケア2回目ありがとうございました。 <br>岩本先生の声がけのおかげもあって娘のモチベーションもあがり <br>治るんだっていう安心感があります。 <br>娘本人が今までずーっと辛かったし治らないんじゃないかという不安があった事が改めてわかりました。私自身もそんな娘に対して受け止めることも、どうしたらいいのかもわかりませんでした。お互いに精神的にもしんどかったと思います。 <br>岩本先生からのアドバイスのおかげで、 <br>アトピー性皮膚炎と向き合う事ができます。 <br>私ができるケアと娘自身もできるケアをしっかりして1日でも早く良くなってほしいです。</div>\r\n</div>\r\n<!-- 事業者からの返信 --><!-- 関連CTA --></div>\r\n<p>&nbsp;</p>\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"https://www.reservestock.jp/page/user_recommend/9582\" style=\"font-size: 17px; font-weight: bolder; letter-spacing: 2px; margin: 10px auto; display: block; text-align: center; max-width: 364px; padding: 0.7em 1em; text-decoration: none; background: #8fbf9f; color: #ffffff; border-bottom: solid 4px #6b8f77; border-radius: 18px\">⭐️ 満足度の理由を口コミで確認 </a></p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>\r\n<!-- ========== お問い合わせ ========== --><!-- ========== サポートイベント（複数時は日付リスト） ========== --></section>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<!-- === /マイページ導線 =================================================== -->\r\n<div style=\"max-width: 640px; margin: 18px 10px; border: 1px solid #efe7df; border-radius: 14px; padding: 18px; background: #f4dddb\">\r\n<h3 style=\"font-size: 19px; margin: 0 0 10px 0; line-height: 1.5; color: #222222; text-align: center\"> マイページで「購入済みコンテンツ」や「イベントのアーカイブ」をチェック</h3>\r\n<!-- 大ボタン：まずはマイページ -->\r\n<p style=\"font-size: 18pt; margin: 8px auto\"><a href=\"https://smart.reservestock.jp/my_page/top/9582/((proposal_code))\" style=\"font-size: 17px; font-weight: bolder; letter-spacing: 2px; margin: 10px auto; display: block; text-align: center; max-width: 364px; padding: 0.7em 1em; text-decoration: none; background: #8fbf9f; color: #ffffff; border-bottom: solid 4px #6b8f77; border-radius: 18px\">((customer_name)) 専用マイページを開く ▶</a></p>\r\n<!-- コピー用の生URL（到達率向上のため） -->\r\n<p style=\"font-size: 13px; word-break: break-all; margin-top: 12px; text-align: center\">URL: https://smart.reservestock.jp/my_page/top/9582/((proposal_code))</p>\r\n</div>\r\n<!-- ===================== LINE誘導（強化版） ===================== -->\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<p style=\"font-size: 19px\">&nbsp;</p>\r\n<div style=\"max-width: 640px; margin: 18px 10px; border: 6px dashed #9ccc65; border-radius: 12px; padding: 12px\">\r\n<div style=\"max-width: 640px; margin: 0 5px\">\r\n<p style=\"font-size: 19px; margin: 0 0 6px 0; font-weight: bold\">公式LINEで最新情報を最速で受け取りたい